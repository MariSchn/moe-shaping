+    def bandit_active(self) -> bool:
+        """True when this forward pass should route from the bandit policy."""
+        return bandit.is_enabled() and self.training and torch.is_grad_enabled()
+
+    def bandit_routing(self, logits: torch.Tensor):
+        """Top-k routing whose expert choice is trained from bandit feedback.
+
+        Selection is optionally perturbed for exploration and the mixing weights
+        are the usual softmax over the selected logits, but the task gradient into
+        the router weight is blocked. The router's only learning signal is the
+        REINFORCE term that bandit.build_loss() builds once the per-token LM loss
+        -- the bandit reward -- is known.
+        """
+        cfg = bandit.get_config()
+        num_tokens, num_experts = logits.shape
+        scores = logits.float()
+
+        with torch.no_grad():
+            selection_scores = scores.detach()
