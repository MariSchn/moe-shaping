+                spread = selection_scores.max() - selection_scores.min() + 1.0
+                bonus = torch.zeros_like(selection_scores)
+                rows = torch.arange(num_tokens, device=logits.device)
+                bonus[rows, forced] = spread * exploring.to(selection_scores.dtype)
+                selection_scores = selection_scores + bonus
