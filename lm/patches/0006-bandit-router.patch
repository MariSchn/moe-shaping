@@ -0,0 +1,333 @@
+"""Contextual-bandit (REINFORCE) training of the MoE router (moe-shaping).
+
+The router normally learns from the task gradient that flows back through the
+mixing weights it produces. This module replaces that signal with bandit
+feedback: the router picks top-k experts per token (optionally with exploration
+noise), the model runs, and the per-token language-model loss becomes the reward
+for every routing decision that token passed through.
+
+Flow across the codebase:
+
+  TopKRouter.routing()  -- picks experts, blocks the task gradient into the
+                           router weight, and calls record() with the per-token
+                           log-probability of the chosen action.
+  loss_func()           -- once the per-token LM loss exists, calls
+                           build_loss(), which turns the recorded actions and
+                           the reward into a scalar surrogate added to the loss.
+  training_log()        -- calls pop_metrics() for the "bandit/*" diagnostics.
+
+Records live for exactly one micro-batch: the schedule runs forward_step (which
+ends in loss_func) and backward_step per micro-batch, so build_loss() always
+consumes the records the forward pass just wrote.
+"""
+
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Optional
+
+import torch
+
+
+@dataclass
+class BanditConfig:
+    """Everything the --bandit-* CLI flags control. See _add_moe_args."""
+
+    enabled: bool = False
+    baseline: str = "batch_mean"  # batch_mean | critic | none
+    explore: str = "gumbel"  # none | gumbel | epsilon
+    tau: float = 1.0
+    tau_final: Optional[float] = None
+    epsilon: float = 0.1
+    epsilon_final: Optional[float] = None
+    coeff: float = 1.0
+    advantage_norm: str = "ema_std"  # none | batch_std | ema_std
+    entropy_weight: float = 0.0
+    critic_coeff: float = 0.01
+    keep_task_gradient: bool = False
+    grad_align_interval: int = 0
+
+
+@dataclass
+class _Record:
+    """One MoE layer's routing action for the current micro-batch."""
+
+    layer_number: int
+    log_prob: torch.Tensor  # [num_tokens], differentiable w.r.t. the router weight
+    entropy: torch.Tensor  # [num_tokens], differentiable
+    value: Optional[torch.Tensor] = None  # [num_tokens], critic prediction of the loss
+    logits: Optional[torch.Tensor] = None  # [num_tokens, num_experts], for grad alignment
+
+
+@dataclass
+class _State:
+    config: BanditConfig = field(default_factory=BanditConfig)
+    records: List[_Record] = field(default_factory=list)
+    progress: float = 0.0  # training progress in [0, 1], drives the anneals
+    iteration: int = 0
+    adv_ema_var: Optional[torch.Tensor] = None
+    metric_sums: Dict[str, Any] = field(default_factory=dict)
+    metric_count: int = 0
+
+
+_STATE = _State()
+
+_ADV_EMA_DECAY = 0.99
+
+
+def configure(args: Any) -> None:
+    """Install the CLI configuration. Called once, before training starts."""
+    _STATE.config = BanditConfig(
+        enabled=args.bandit_router,
+        baseline=args.bandit_baseline,
+        explore=args.bandit_explore,
+        tau=args.bandit_tau,
+        tau_final=args.bandit_tau_final,
+        epsilon=args.bandit_epsilon,
+        epsilon_final=args.bandit_epsilon_final,
+        coeff=args.bandit_coeff,
+        advantage_norm=args.bandit_advantage_norm,
+        entropy_weight=args.bandit_entropy_weight,
+        critic_coeff=args.bandit_critic_coeff,
+        keep_task_gradient=args.bandit_keep_task_gradient,
+        grad_align_interval=args.bandit_grad_align_interval,
+    )
+
+
+def get_config() -> BanditConfig:
+    """The active configuration (disabled by default)."""
+    return _STATE.config
+
+
+def is_enabled() -> bool:
+    """True when the router should be trained from bandit feedback."""
+    return _STATE.config.enabled
+
+
+def set_progress(iteration: int, train_iters: int) -> None:
+    """Report training progress so the temperature / epsilon anneals can advance."""
+    _STATE.iteration = iteration
+    _STATE.progress = min(max(iteration / max(train_iters, 1), 0.0), 1.0)
+
+
+def _anneal(start: float, final: Optional[float]) -> float:
+    """Linear interpolation from start to final over the run."""
+    if final is None:
+        return start
+    return start + (final - start) * _STATE.progress
+
+
+def current_tau() -> float:
+    """Gumbel temperature for this step. Higher = more exploration."""
+    return max(_anneal(_STATE.config.tau, _STATE.config.tau_final), 1e-4)
+
+
+def current_epsilon() -> float:
+    """Epsilon-greedy exploration rate for this step."""
+    return max(_anneal(_STATE.config.epsilon, _STATE.config.epsilon_final), 0.0)
+
+
+class BlockTaskGradient(torch.autograd.Function):
+    """Identity that returns a zero gradient.
+
+    Keeps the mixing weights connected to the router logits in the autograd graph
+    -- so anything else attached to them (the aux load-balancing loss, via
+    MoEAuxLossAutoScaler) still receives its gradient -- while ensuring the task
+    loss itself contributes nothing to the router weight. A plain .detach() would
+    disconnect the graph and silently drop the aux loss.
+    """
+
+    @staticmethod
+    def forward(ctx, x: torch.Tensor) -> torch.Tensor:
+        """Pass the logits through unchanged."""
+        return x
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor) -> torch.Tensor:
+        """Absorb the task gradient."""
+        return torch.zeros_like(grad_output)
+
+
+def reset_records() -> None:
+    """Drop any records left over from an aborted micro-batch."""
+    _STATE.records.clear()
+
+
+def record(
+    layer_number: int,
+    log_prob: torch.Tensor,
+    entropy: torch.Tensor,
+    value: Optional[torch.Tensor] = None,
+    logits: Optional[torch.Tensor] = None,
+) -> None:
+    """Store one layer's routing action for the current micro-batch."""
+    _STATE.records.append(
+        _Record(
+            layer_number=layer_number,
+            log_prob=log_prob,
+            entropy=entropy,
+            value=value,
+            logits=logits,
+        )
+    )
+
+
+def _accumulate_metric(name: str, value: Any) -> None:
+    """Accumulate a diagnostic. Tensors stay on the GPU until pop_metrics()."""
+    prev = _STATE.metric_sums.get(name)
+    _STATE.metric_sums[name] = value if prev is None else prev + value
+
+
+def pop_metrics() -> Dict[str, float]:
+    """Return the bandit diagnostics averaged over the micro-batches since the last call.
+
+    This is the only place tensor diagnostics are read back to the host, so the
+    training step itself never blocks on a device synchronization for logging.
+    """
+    if _STATE.metric_count == 0:
+        return {}
+    metrics = {
+        k: (v.item() if torch.is_tensor(v) else v) / _STATE.metric_count
+        for k, v in _STATE.metric_sums.items()
+    }
+    _STATE.metric_sums.clear()
+    _STATE.metric_count = 0
+    return metrics
+
+
+def _normalize_advantage(advantage: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    """Scale the advantage to unit standard deviation over the valid tokens."""
+    mode = _STATE.config.advantage_norm
+    if mode == "none":
+        return advantage
+
+    total = weight.sum().clamp_min(1.0)
+    mean = (advantage * weight).sum() / total
+    var = ((advantage - mean) ** 2 * weight).sum() / total
+
+    if mode == "ema_std":
+        if _STATE.adv_ema_var is None:
+            _STATE.adv_ema_var = var.detach().clone()
+        else:
+            _STATE.adv_ema_var.mul_(_ADV_EMA_DECAY).add_(var.detach(), alpha=1 - _ADV_EMA_DECAY)
+        var = _STATE.adv_ema_var
+    elif mode != "batch_std":
+        raise ValueError(f"Unknown --bandit-advantage-norm: {mode}")
+
+    return advantage / var.sqrt().clamp_min(1e-6)
+
+
+def _grad_alignment(task_loss: torch.Tensor, policy_loss: torch.Tensor) -> Optional[float]:
+    """Cosine similarity of the task and REINFORCE gradients w.r.t. the router logits.
+
+    Answers whether the bandit estimator points the same way the true task
+    gradient does. Requires --bandit-keep-task-gradient, since with the task
+    gradient blocked there is no task path to the logits to compare against.
+    """
+    logits = [r.logits for r in _STATE.records if r.logits is not None]
+    if not logits:
+        return None
+
+    task_grads = torch.autograd.grad(
+        task_loss, logits, retain_graph=True, allow_unused=True, materialize_grads=True
+    )
+    policy_grads = torch.autograd.grad(
+        policy_loss, logits, retain_graph=True, allow_unused=True, materialize_grads=True
+    )
+
+    flat_task = torch.cat([g.float().flatten() for g in task_grads])
+    flat_policy = torch.cat([g.float().flatten() for g in policy_grads])
+    denom = flat_task.norm() * flat_policy.norm()
+    if denom == 0:
+        return None
+    return (flat_task @ flat_policy / denom).item()
+
+
+def build_loss(
+    per_token_loss: torch.Tensor, loss_mask: torch.Tensor, task_loss: torch.Tensor
+) -> torch.Tensor:
+    """Build the bandit surrogate for the micro-batch and clear the records.
+
+    Args:
+        per_token_loss: [batch, seq] language-model loss, the negative reward.
+        loss_mask: [batch, seq] 1.0 for tokens that count.
+        task_loss: the scalar summed LM loss, used only by the grad-alignment probe.
+
+    Returns:
+        A scalar to add to the summed task loss. It is normalized the same way
+        the LM loss is (the schedule divides the returned loss by the token count
+        and the micro-batch count), so the terms stay commensurate.
+    """
+    records = _STATE.records
+    if not records:
+        return torch.zeros((), device=per_token_loss.device, dtype=torch.float32)
+    _STATE.records = []
+
+    cfg = _STATE.config
+
+    # The router flattens its input as [seq, batch, hidden] -> [seq * batch], while
+    # the LM loss arrives as [batch, seq]. Transpose so token t means the same
+    # token on both sides.
+    reward_source = per_token_loss.detach().float().transpose(0, 1).reshape(-1)
+    weight = loss_mask.detach().float().transpose(0, 1).reshape(-1)
+    total_weight = weight.sum().clamp_min(1.0)
+
+    # Reward is the negated loss: routing that made the token cheaper to predict
+    # should be reinforced.
+    reward = -reward_source
+
+    if cfg.baseline == "batch_mean":
+        shared_baseline = (reward * weight).sum() / total_weight
+    elif cfg.baseline in ("none", "critic"):
+        shared_baseline = None
+    else:
+        raise ValueError(f"Unknown --bandit-baseline: {cfg.baseline}")
+
+    policy_loss = torch.zeros((), device=reward.device, dtype=torch.float32)
+    critic_loss = torch.zeros((), device=reward.device, dtype=torch.float32)
+    entropy_sum = torch.zeros((), device=reward.device, dtype=torch.float32)
+    advantage_sq = torch.zeros((), device=reward.device, dtype=torch.float32)
+
+    for rec in records:
+        if cfg.baseline == "critic":
+            assert rec.value is not None, "critic baseline needs a value head"
+            baseline = rec.value.float().detach()
+            critic_loss = critic_loss + (((rec.value.float() - reward) ** 2) * weight).sum()
+        elif shared_baseline is not None:
+            baseline = shared_baseline
+        else:
+            baseline = 0.0
+
+        advantage = _normalize_advantage(reward - baseline, weight)
+        policy_loss = policy_loss - (advantage * rec.log_prob.float() * weight).sum()
+        entropy_sum = entropy_sum + (rec.entropy.float() * weight).sum()
+        advantage_sq = advantage_sq + (advantage**2 * weight).sum() / total_weight
+
+    num_layers = len(records)
+    bandit_loss = cfg.coeff * policy_loss
+    if cfg.entropy_weight != 0.0:
+        # Subtracting entropy from the loss maximizes it, keeping the policy from
+        # collapsing onto one expert.
+        bandit_loss = bandit_loss - cfg.entropy_weight * entropy_sum
+    if cfg.baseline == "critic":
+        bandit_loss = bandit_loss + cfg.critic_coeff * critic_loss
+
+    _accumulate_metric("bandit/policy_loss", (policy_loss / total_weight).detach())
+    _accumulate_metric("bandit/entropy", (entropy_sum / total_weight / num_layers).detach())
+    _accumulate_metric("bandit/advantage_rms", (advantage_sq / num_layers).sqrt().detach())
+    _accumulate_metric("bandit/reward_std", reward_source.std().detach())
+    _accumulate_metric("bandit/tau", current_tau())
+    if cfg.baseline == "critic":
+        _accumulate_metric(
+            "bandit/critic_mse", (critic_loss / total_weight / num_layers).detach()
+        )
+
+    if (
+        cfg.grad_align_interval > 0
+        and _STATE.iteration % cfg.grad_align_interval == 0
+        and cfg.keep_task_gradient
+    ):
+        cosine = _grad_alignment(task_loss, policy_loss)
+        if cosine is not None:
+            _accumulate_metric("bandit/grad_alignment", cosine)
+
+    _STATE.metric_count += 1
+    return bandit_loss.float()
