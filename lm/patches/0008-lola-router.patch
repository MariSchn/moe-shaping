# Patch: Router-router LOLA opponent shaping (--lola-router-alpha)
#
# Goal:
#   Scale the toy src/utils.py apply_router_router_lola_shaping (lola_learner="all") to the
#   Megatron LM: every selected router row of a token is a LOLA learner that anticipates the
#   naive gradient step of the other selected rows, i.e. row i gets the extra gradient
#       -alpha * grad_{w_i} [ stopgrad(grad_{w_j} l_t) . grad_{w_j} l_t ]   summed over j != i
#   for each token t, averaged over the global batch (as the toy averages over samples).
#
# Why it is cheap here (no second backward pass):
#   The router is linear and bias-free (z_t = W x_t) and the gate is the softmax over the
#   selected logits. Treating the MoE layer output as the point at which the downstream loss is
#   linearized (the toy likewise detaches the expert outputs), l_t = sum_{e in S_t} p_e c_e with
#   c_e = dL/dp_e -- exactly the gradient autograd already delivers to the probs tensor. Then
#   grad_{w_j} l_t = delta_j x_t with delta_j = p_j (c_j - cbar), and the correction to logit i
#   is -alpha ||x_t||^2 sum_{j != i} delta_j H_ij with H_ij = d delta_j / d z_i
#   = p_j (1[i=j] - p_i)(c_j - cbar) - p_i p_j (c_i - cbar), a k x k computation per token.
#   The closed form was checked against a double-backward implementation of the toy formula
#   (max abs error 1e-7 at fp32).
#   Approximation vs the toy: curvature of the loss downstream of the MoE layer is dropped
#   (first-order in the layer output); the toy's regression loss keeps it.
#
# What this patch does:
#   megatron/core/transformer/moe/lola.py (new): an identity autograd Function on the top-k
#   probs that, in backward, receives dL/dprobs, rescales it to per-token gradients (Megatron
#   divides each micro-batch loss by its token count and the number of micro-batches; bf16 has no
#   loss scale), computes the correction and returns it as an extra gradient into the router
#   logits, so it reaches the router weight through the normal autograd / DDP path.
#   Logs lola/correction_to_task_grad (norm of the correction over norm of the task gradient on
#   the selected logits, mean over layers) to size alpha.
#   router.py: applied after top-k selection, before capacity dropping; asserts softmax
#   post-top-k scoring, no expert bias, no bandit, no top-k scaling factor.
#   arguments.py: --lola-router-alpha (0 disables). training.py: lola.configure before model build.
#   --lola-max-ratio R (default 0 = off, the plain method): caps each token's correction at R times
#   the norm of that token's task gradient on the selected logits and zeroes non-finite values.
#   Added because plain LOLA diverged at LM scale (alpha 3e-4 by a runaway, 1e-4 by a sudden NaN
#   at step 591 in one of two seeds); the cap only touches outlier tokens at small alpha.
#
# How to find the right location in a future Megatron version:
#   router.py: TopKRouter.routing(), right after topk_routing_with_score_function.
#
# Applied to: Megatron-LM core_v0.16.1 (commit 55ac7082), on top of patches 0001-0007.
#
diff --git a/megatron/core/transformer/moe/lola.py b/megatron/core/transformer/moe/lola.py
new file mode 100644
index 000000000..a95ad8b66
--- /dev/null
+++ b/megatron/core/transformer/moe/lola.py
@@ -0,0 +1,78 @@
+from dataclasses import dataclass
+
+import torch
+
+from megatron.core.transformer.moe.moe_utils import save_to_aux_losses_tracker
+
+
+@dataclass
+class LolaConfig:
+    alpha: float = 0.0
+    max_ratio: float = 0.0
+
+
+_config = LolaConfig()
+
+
+def configure(alpha, max_ratio=0.0):
+    _config.alpha = alpha
+    _config.max_ratio = max_ratio
+
+
+def _bounded(correction, task_logit_grad, max_ratio):
+    correction = torch.nan_to_num(correction, nan=0.0, posinf=0.0, neginf=0.0)
+    limit = max_ratio * task_logit_grad.norm(dim=-1, keepdim=True)
+    scale = (limit / correction.norm(dim=-1, keepdim=True).clamp_min(1e-30)).clamp(max=1.0)
+    return correction * scale
+
+
+def is_enabled():
+    return _config.alpha > 0
+
+
+def router_router_correction(probs, per_token_grad, hidden_sq_norm, alpha):
+    p = probs.float()
+    g = per_token_grad.float()
+    deviation = g - (p * g).sum(dim=-1, keepdim=True)
+    delta = p * deviation
+    a = (delta * p * deviation).sum(dim=-1, keepdim=True)
+    b = (delta * p).sum(dim=-1, keepdim=True)
+    shaped = delta * p * deviation - p * a - p * deviation * b
+    own = delta * p * deviation * (1.0 - 2.0 * p)
+    return -alpha * hidden_sq_norm.unsqueeze(-1) * (shaped - own), delta
+
+
+class _RouterRouterShaping(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, probs, logits, hidden_sq_norm, tokens_scale, router):
+        ctx.save_for_backward(probs, hidden_sq_norm)
+        ctx.tokens_scale = tokens_scale
+        ctx.router = router
+        return probs.view_as(probs)
+
+    @staticmethod
+    def backward(ctx, grad_probs):
+        probs, hidden_sq_norm = ctx.saved_tensors
+        scale = ctx.tokens_scale
+        correction, task_logit_grad = router_router_correction(
+            probs, grad_probs * scale, hidden_sq_norm, _config.alpha
+        )
+        if _config.max_ratio > 0:
+            correction = _bounded(correction, task_logit_grad, _config.max_ratio)
+        extra = correction / scale
+        _track(ctx.router, extra, task_logit_grad / scale)
+        return grad_probs, extra.to(grad_probs.dtype), None, None, None
+
+
+def _track(router, extra, task_logit_grad):
+    num_layers = router.config.num_layers
+    if router.config.mtp_num_layers is not None:
+        num_layers += router.config.mtp_num_layers
+    ratio = extra.norm() / task_logit_grad.norm().clamp_min(1e-30)
+    save_to_aux_losses_tracker("lola/correction_to_task_grad", ratio, router.layer_number, num_layers)
+
+
+def apply(router, probs, logits, hidden, num_microbatches):
+    hidden_sq_norm = hidden.detach().float().pow(2).sum(dim=-1)
+    tokens_scale = float(logits.shape[0] * num_microbatches)
+    return _RouterRouterShaping.apply(probs, logits, hidden_sq_norm, tokens_scale, router)
