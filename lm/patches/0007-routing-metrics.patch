@@ -867,7 +867,9 @@ def apply_router_token_dropping(
 # identity element of the op so that a layer which never writes does not affect the result
 # ("sum" -> 0, "max" -> -inf, "min" -> +inf, the latter two being ignored by max()/min();
 # "collect" -> 0, dense layers stay all-zero and are dropped before pooling quantiles).
-_AUX_LOSS_TRACKER_INIT = {"sum": 0.0, "max": float("-inf"), "min": float("inf"), "collect": 0.0}
+_AUX_LOSS_TRACKER_INIT = {
+    "sum": 0.0, "max": float("-inf"), "min": float("inf"), "collect": 0.0, "maxvio": 0.0
+}
 
 # Quantiles (in [0, 1]) of the per-expert load distribution, pooled over all experts of all MoE
 # layers and logged as "load/p10".."load/p90" alongside "load/min" (the p0 extreme) and
@@ -875,6 +877,28 @@ _AUX_LOSS_TRACKER_INIT = {"sum": 0.0, "max": float("-inf"), "min": float("inf"),
 _LOAD_QUANTILES = (0.10, 0.25, 0.50, 0.75, 0.90)
 
 
+def max_violation(load: torch.Tensor) -> torch.Tensor:
+    mean = load.mean(dim=-1)
+    return (load.max(dim=-1).values - mean) / mean
+
+
+def _track_maxvio(entry, iteration, writer, wandb_writer, total_loss_dict):
+    load = entry["values"].float()
+    if torch.distributed.is_initialized():
+        torch.distributed.all_reduce(load, group=parallel_state.get_data_parallel_group())
+    per_layer = max_violation(load[load.sum(dim=1) > 0])
+    scalars = {"maxvio/batch": per_layer.mean(), "maxvio/batch_worst_layer": per_layer.max()}
+    if total_loss_dict is not None:
+        for key, value in scalars.items():
+            total_loss_dict[key] = total_loss_dict.get(key, 0.0) + value
+    scalars.update({f"maxvio/batch_layer_{i:02d}": v for i, v in enumerate(per_layer.tolist())})
+    if writer is not None:
+        for key, value in scalars.items():
+            writer.add_scalar(key, value, iteration)
+    if wandb_writer:
+        wandb_writer.log({key: float(value) for key, value in scalars.items()}, iteration)
+
+
 def save_to_aux_losses_tracker(
     name: str,
     loss: torch.Tensor,
@@ -913,7 +937,7 @@ def save_to_aux_losses_tracker(
     tracker = get_moe_layer_wise_logging_tracker()
     if name not in tracker:
         tracker[name] = {}
