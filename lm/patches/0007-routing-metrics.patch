diff --git a/megatron/core/transformer/moe/routing_stats.py b/megatron/core/transformer/moe/routing_stats.py
new file mode 100644
index 000000000..56a377960
--- /dev/null
+++ b/megatron/core/transformer/moe/routing_stats.py
@@ -0,0 +1,62 @@
+import torch
+
+from megatron.core.transformer.moe.moe_utils import save_to_aux_losses_tracker
+
+_recording = None
+_eval_counts = {}
+
+
+def observe(router, routing_map, dropped_routing_map, padding_mask=None):
+    if router.layer_number is None:
+        return
+    if padding_mask is not None:
+        routing_map = routing_map[padding_mask]
+        dropped_routing_map = dropped_routing_map[padding_mask]
+    if router.training and torch.is_grad_enabled():
+        _track_training(router, routing_map, dropped_routing_map)
+    elif _recording is not None:
+        _recording.setdefault(router.layer_number, []).append(
+            routing_map.to(torch.float16).topk(router.topk, dim=-1).indices.to(torch.uint8)
+        )
+    elif not router.training:
+        counts = routing_map.sum(dim=0, dtype=torch.float64)
+        if router.layer_number in _eval_counts:
+            _eval_counts[router.layer_number] += counts
+        else:
+            _eval_counts[router.layer_number] = counts
+
+
+def _track_training(router, routing_map, dropped_routing_map):
+    num_layers = router.config.num_layers
+    if router.config.mtp_num_layers is not None:
+        num_layers += router.config.mtp_num_layers
+    assigned = routing_map.sum(dim=0, dtype=torch.float32)
+    save_to_aux_losses_tracker(
+        "maxvio", assigned / routing_map.shape[0], router.layer_number, num_layers,
+        reduce_op="maxvio",
+    )
+    if dropped_routing_map is not routing_map:
+        kept = dropped_routing_map.sum(dtype=torch.float32)
+        save_to_aux_losses_tracker(
+            "moe/token_drop_fraction", 1.0 - kept / assigned.sum(), router.layer_number,
+            num_layers,
+        )
+
+
+def start_recording():
+    global _recording
+    _recording = {}
+
+
+def stop_recording():
+    global _recording
+    recorded = {layer: torch.cat(chunks) for layer, chunks in _recording.items()}
+    _recording = None
+    return recorded
+
+
+def pop_eval_counts():
+    global _eval_counts
+    counts = _eval_counts
+    _eval_counts = {}
+    return counts
