             # over the pooled experts of all MoE layers at logging time. Dense layers never
             # write, so their all-zero row (row-sum 0) is dropped before pooling.
@@ -1058,6 +1082,9 @@ def track_moe_metrics(
 
     for name, entry in tracker.items():
         reduce_op = entry.get("reduce_op", "sum")
+        if reduce_op == "maxvio":
+            _track_maxvio(entry, iteration, writer, wandb_writer, total_loss_dict)
+            continue
         if reduce_op == "collect":
             # Pooled quantiles of the per-expert load over all experts of all MoE layers.
             # entry["values"] is (num_layers, num_experts) accumulated across micro-batches;
